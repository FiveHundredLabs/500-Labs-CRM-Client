VITE_API_BASE_URL=/api/v1

# Used by the Vite dev server only. This value is not exposed to browser code.
DEV_API_TARGET=http://localhost:3000

# Production Vercel must also use:
# VITE_API_BASE_URL=/api/v1
#
# Vercel routing/server configuration. Configure the real value in
# Vercel Project Settings, not in browser code and not in VITE_* variables.
API_UPSTREAM_ORIGIN=
